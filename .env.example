# Self-host env for the Go backend (see docs/GO_SELFHOST_PLAN.md, docker-compose.yml)

ENVIRONMENT=dev
PORT=8080

# Postgres — ONE shared database today: queries join across domain tables,
# so all four URLs must point at the same DB until a real schema split exists.
MACRO_DB_URL=postgres://macro:macro@localhost:5432/macrodb
EMAIL_DB_URL=postgres://macro:macro@localhost:5432/macrodb
COMMS_DB_URL=postgres://macro:macro@localhost:5432/macrodb
NOTIFICATION_DB_URL=postgres://macro:macro@localhost:5432/macrodb

# Per-service ports (distinct so `macro all` doesn't collide)
GATEWAY_PORT=8085
GATEWAY_INTERNAL_PORT=8086
NOTIFICATION_PORT=8090
SYNC_PORT=8787

# NATS JetStream
NATS_URL=nats://localhost:4222

# Valkey (Redis-compatible)
VALKEY_ADDR=localhost:6379

# MinIO (S3-compatible)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# Casdoor (identity, replaces FusionAuth)
CASDOOR_ENDPOINT=http://localhost:8000
CASDOOR_CLIENT_ID=
CASDOOR_CLIENT_SECRET=
CASDOOR_ORG=macro

# SMTP (replaces SES; Mailhog in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM=macro@localhost

# Push providers (replaces SNS)
FCM_SERVICE_ACCOUNT_JSON=
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_SANDBOX=false

# Gateway
GATEWAY_PORT=8085
GATEWAY_INTERNAL_PORT=8086
GATEWAY_JWT_SECRET=
GATEWAY_INTERNAL_API_KEY=

# AI
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Migrations (defaults to crates/macro_db_client/migrations)
# MIGRATIONS_DIR=/app/migrations

# OTel (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
